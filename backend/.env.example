# ---------------------------------------------------------------------------
# Local development config. Copy this file to `.env` and fill in your key --
# everything else already works with zero AWS setup.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Database -- SQLite by default: a single local file (./jd_agent.db),
# created automatically on first run. No server to install or start.
# For production (or if you specifically want Postgres/RDS), set e.g.:
#   DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/jd_agent
DATABASE_URL=sqlite:///./jd_agent.db

# Storage -- "local" writes JD text/JSON/Markdown under ./storage_data on
# disk. No AWS account or credentials needed. Switch to "s3" only when you
# actually deploy to AWS.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage_data

# Queue -- not needed for local dev. The API processes each JD synchronously
# as soon as you call POST /api/jds/{id}/analyze, so you do NOT need to run
# `python -m app.workers.worker` at all locally. Leave this as "local".
QUEUE_BACKEND=local

# LLM provider abstraction: mock | anthropic | gemini
#   mock      -> no API key needed, deterministic rule-based extraction (for tests/demo)
#   gemini    -> paste a free key from https://aistudio.google.com/apikey below
#   anthropic -> paste a key from https://console.anthropic.com below
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# Paste your key here (never commit a real key to source control):
GEMINI_API_KEY=paste-your-gemini-key-here
# ANTHROPIC_API_KEY=paste-your-anthropic-key-here

# Auth -- not required to run the API/worker locally; only relevant if you
# wire up the login flow.
AUTH_PROVIDER=supabase     # supabase | auth0 | cognito

ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Everything below is optional and only used if you flip STORAGE_BACKEND or
# QUEUE_BACKEND to their AWS-backed options for a real deployment.
# ---------------------------------------------------------------------------
# S3_BUCKET=jd-agent-artifacts
# AWS_REGION=us-east-1
# SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/jd-processing-queue
# REDIS_URL=redis://localhost:6379/0
