# ---------------------------------------------------------------------------
# Local development config. Copy this file to `.env` --
# everything works completely offline with zero external cloud setup.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Database -- SQLite by default: a single local file (./jd_agent.db),
# created automatically on first run. No server to install or start.
DATABASE_URL=sqlite:///./jd_agent.db

# Storage -- "local" writes JD text/JSON/Markdown under ./storage_data on disk.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage_data

# Queue -- "local" processes each JD synchronously inline.
QUEUE_BACKEND=local

# LLM provider abstraction: ollama | mock | gemini | anthropic
#   ollama    -> fully offline local LLM (requires Ollama running locally)
#   mock      -> no LLM needed, deterministic rule-based extraction
#   gemini    -> optional cloud provider via Google AI Studio API key
#   anthropic -> optional cloud provider via Anthropic API key
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Optional cloud API keys (only used if LLM_PROVIDER is switched to gemini or anthropic):
# GEMINI_API_KEY=your-gemini-key-here
# ANTHROPIC_API_KEY=your-anthropic-key-here

# Auth
AUTH_PROVIDER=supabase     # supabase | auth0 | cognito

ENVIRONMENT=development
